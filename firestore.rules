rules_version = '2';
// RITMO · Reglas de seguridad de Firestore
// Pegar en: Consola Firebase › Firestore Database › Reglas › Publicar.
service cloud.firestore {
  match /databases/{db}/documents {

    function email() { return request.auth.token.email.lower(); }
    function signed() { return request.auth != null && request.auth.token.email != null; }
    // Superusuario inicial (arranque). Debe coincidir con js/firebase-config.js
    function bootstrap() { return signed() && email() == 'julio.gutierrez@ampm.com.ni'; }
    function registered() { return signed() && exists(/databases/$(db)/documents/usuarios/$(email())); }
    function me() { return get(/databases/$(db)/documents/usuarios/$(email())).data; }
    function active() { return registered() && me().activo == true; }
    function rol(r) { return active() && me().rol == r; }
    function isSuper() { return bootstrap() || rol('Superusuario'); }
    function sees(t) { return isSuper() || (active() && (me().alcance == 'Todas' || t in me().tiendas)); }
    function owns(t) { return rol('Editor') && t in me().tiendas; }

    // Usuarios: cada quien lee su ficha; solo el superusuario escribe.
    match /usuarios/{u} {
      allow read: if isSuper() || (signed() && email() == u);
      allow write: if isSuper();
      // Cada usuario solo registra sus fechas de acceso y de cambio de contraseña.
      allow update: if signed() && email() == u
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['primerLogin', 'ultimoLogin', 'claveCambiada']);
    }

    // Tiendas: visibles según alcance; solo el superusuario escribe.
    match /tiendas/{t} {
      allow read: if sees(t);
      allow write: if isSuper();
    }

    // Entregas por quincena: estado visible para todo el alcance (GZ, distrito, operaciones, planilla).
    match /entregas/{id} {
      allow read: if sees(resource.data.tienda);
      allow create, update: if isSuper()
        || (owns(request.resource.data.tienda) && request.resource.data.por == email());
      allow delete: if isSuper();

      // Contenido de la entrega (horario, planilla, MBK y hoja de asistencia).
      match /datos/{doc} {
        // Lo ven la tienda, planilla, GZ, distrito y operaciones dentro de su alcance (solo lectura).
        allow read: if isSuper()
          || owns(resource.data.tienda)
          || (active() && sees(resource.data.tienda));
        allow write: if isSuper() || owns(request.resource.data.tienda);
      }
    }

    // Mi horario: copia de trabajo del Generador de cada tienda (la edita su gerente).
    match /trabajo/{t} {
      allow read, write: if isSuper() || owns(t);
    }

    // Calendario de planilla por quincena: lo ven todos; lo publican planilla y superusuario.
    match /calendario/{q} {
      allow read: if isSuper() || active();
      allow write: if isSuper() || rol('Descargar');
    }

    // Todo lo demás, cerrado.
    match /{path=**} { allow read, write: if false; }
  }
}
